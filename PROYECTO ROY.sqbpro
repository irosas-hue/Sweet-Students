--  Base de datos: Sweet Students (versión SQLite)
--  Repostería escolar - esquema para la página web
-- =========================================================

PRAGMA foreign_keys = ON;

-- ---------------------------------------------------------
-- Tabla: categorias
-- ---------------------------------------------------------
CREATE TABLE categorias (
    id_categoria    INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre          TEXT NOT NULL,
    descripcion     TEXT,
    creado_en       TEXT DEFAULT CURRENT_TIMESTAMP
);

-- ---------------------------------------------------------
-- Tabla: productos
-- ---------------------------------------------------------
CREATE TABLE productos (
    id_producto     INTEGER PRIMARY KEY AUTOINCREMENT,
    id_categoria    INTEGER NOT NULL,
    nombre          TEXT NOT NULL,
    descripcion     TEXT,
    precio          REAL NOT NULL,      -- precio en colones (CRC)
    imagen_url      TEXT,
    disponible      INTEGER DEFAULT 1,  -- 1 = true, 0 = false
    creado_en       TEXT DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_categoria) REFERENCES categorias(id_categoria) ON DELETE CASCADE
);

-- ---------------------------------------------------------
-- Tabla: sabores
-- ---------------------------------------------------------
CREATE TABLE sabores (
    id_sabor        INTEGER PRIMARY KEY AUTOINCREMENT,
    id_producto     INTEGER NOT NULL,
    nombre          TEXT NOT NULL,
    FOREIGN KEY (id_producto) REFERENCES productos(id_producto) ON DELETE CASCADE
);

-- ---------------------------------------------------------
-- Tabla: clientes
-- ---------------------------------------------------------
CREATE TABLE clientes (
    id_cliente      INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre          TEXT NOT NULL,
    telefono        TEXT NOT NULL,
    colegio         TEXT,
    creado_en       TEXT DEFAULT CURRENT_TIMESTAMP
);

-- ---------------------------------------------------------
-- Tabla: pedidos
-- ---------------------------------------------------------
CREATE TABLE pedidos (
    id_pedido       INTEGER PRIMARY KEY AUTOINCREMENT,
    id_cliente      INTEGER,
    fecha_pedido    TEXT DEFAULT CURRENT_TIMESTAMP,
    estado          TEXT CHECK(estado IN ('pendiente','confirmado','entregado','cancelado')) DEFAULT 'pendiente',
    total           REAL NOT NULL DEFAULT 0,
    FOREIGN KEY (id_cliente) REFERENCES clientes(id_cliente) ON DELETE SET NULL
);

-- ---------------------------------------------------------
-- Tabla: pedido_detalle
-- ---------------------------------------------------------
CREATE TABLE pedido_detalle (
    id_detalle      INTEGER PRIMARY KEY AUTOINCREMENT,
    id_pedido       INTEGER NOT NULL,
    id_producto     INTEGER NOT NULL,
    id_sabor        INTEGER,
    cantidad        INTEGER NOT NULL DEFAULT 1,
    precio_unitario REAL NOT NULL,
    subtotal        REAL GENERATED ALWAYS AS (cantidad * precio_unitario) STORED,
    FOREIGN KEY (id_pedido)   REFERENCES pedidos(id_pedido)   ON DELETE CASCADE,
    FOREIGN KEY (id_producto) REFERENCES productos(id_producto),
    FOREIGN KEY (id_sabor)    REFERENCES sabores(id_sabor)
);

